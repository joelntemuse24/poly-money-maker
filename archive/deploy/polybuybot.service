[Unit]
Description=Polymarket BTC 15m buy-side bot (buybot.py). Do not enable until Joel says. Probe: strategy_buy15m_probe.example.json (dry_run=true, entry_enabled=false).
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ntemusejoel
WorkingDirectory=/home/ntemusejoel/poly-money-maker
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ntemusejoel/poly-money-maker/.env
ExecStart=/home/ntemusejoel/poly-money-maker/.venv/bin/python buybot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
