[Unit]
Description=Polymarket BTC 5m buy-side bot (buybot5m.py)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ntemusejoel
WorkingDirectory=/home/ntemusejoel/poly-money-maker
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ntemusejoel/poly-money-maker/.env
ExecStart=/home/ntemusejoel/poly-money-maker/.venv/bin/python buybot5m.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
