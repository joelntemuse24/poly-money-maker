[Unit]
Description=Polymarket BTC shadow simulator (paper trade only; series from sim/strategy.sim.json)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ntemusejoel
WorkingDirectory=/home/ntemusejoel/poly-money-maker
Environment=PYTHONUNBUFFERED=1
Nice=10
ExecStart=/home/ntemusejoel/poly-money-maker/.venv/bin/python -m sim.shadow
Restart=always
RestartSec=5
Slice=polyshadow-slice.slice
MemoryMax=200M
CPUQuota=20%
# Disk is NOT capped by MemoryMax — host /var/log and sim_data must be managed
# separately (deploy/journald-size.conf, deploy/DISK_OPS.md).

[Install]
WantedBy=multi-user.target
