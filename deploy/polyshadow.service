[Unit]
Description=Polymarket BTC shadow simulator (paper trade only; series from sim/strategy.sim.json)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/poly-money-maker
Environment=PYTHONUNBUFFERED=1
Nice=10
ExecStart=/home/YOUR_USER/poly-money-maker/.venv/bin/python -m sim.shadow
Restart=always
RestartSec=5
MemoryMax=400M
CPUQuota=40%
# Disk is NOT capped by MemoryMax — host /var/log and sim_data must be managed
# separately (deploy/journald-size.conf, deploy/DISK_OPS.md).

[Install]
WantedBy=multi-user.target
