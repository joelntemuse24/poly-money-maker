[Unit]
Description=Polymarket BTC 5m shadow simulator (paper trade only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOUR_USER
WorkingDirectory=/home/YOUR_USER/poly-money-maker
Environment=PYTHONUNBUFFERED=1
Nice=10
ExecStart=/home/YOUR_USER/poly-money-maker/.venv/bin/python -m sim.shadow
Restart=always
RestartSec=5
MemoryMax=400M
CPUQuota=40%

[Install]
WantedBy=multi-user.target
