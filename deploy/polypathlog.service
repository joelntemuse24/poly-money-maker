[Unit]
Description=Polymarket BTC 15m Up/Down CLOB path recorder (no orders; SERIES is 15m only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ntemusejoel
WorkingDirectory=/home/ntemusejoel/poly-money-maker
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ntemusejoel/poly-money-maker/.venv/bin/python pathlog.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
