[Unit]
Description=Continuous armer for the 5m polybuy mint instance (writes buy_data_5m/ARM every 10s)
After=network-online.target

[Service]
Type=simple
User=ntemusejoel
ExecStart=/bin/bash -c 'mkdir -p /home/ntemusejoel/poly-money-maker/buy_data_5m; while :; do echo MINT_REAL_PUSD > /home/ntemusejoel/poly-money-maker/buy_data_5m/ARM; sleep 10; done'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
