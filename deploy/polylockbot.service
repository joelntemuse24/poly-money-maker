[Unit]
Description=Polymarket TWAP-lock taker (lockbot; do not enable until the operator asks; stays dry-run until lockbot.json says otherwise)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ntemusejoel
WorkingDirectory=/home/ntemusejoel/poly-money-maker
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ntemusejoel/poly-money-maker/.env
ExecStart=/home/ntemusejoel/poly-money-maker/.venv/bin/python lockbot.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
