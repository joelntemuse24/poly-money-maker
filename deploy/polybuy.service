[Unit]
Description=Polymarket atomic complete-set mint buyer
After=network-online.target polybot.service
Wants=network-online.target

[Service]
Type=simple
User=ntemusejoel
WorkingDirectory=/home/ntemusejoel/poly-money-maker
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/home/ntemusejoel/poly-money-maker/.env
Nice=15
ExecStart=/home/ntemusejoel/poly-money-maker/.venv-buy/bin/python -m buy
Restart=always
RestartSec=10
MemoryMax=200M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
