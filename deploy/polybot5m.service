[Unit]
Description=Polymarket BTC 5m sell-only bot (bot5m.py, btc-updown-5m series)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ntemusejoel
WorkingDirectory=/home/ntemusejoel/poly-money-maker
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ntemusejoel/poly-money-maker/.venv/bin/python bot5m.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
