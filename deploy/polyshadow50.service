[Unit]
Description=Polymarket BTC shadow simulator — 50-share scaling test (paper trade only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ntemusejoel
WorkingDirectory=/home/ntemusejoel/poly-money-maker
Environment=PYTHONUNBUFFERED=1
Nice=12
ExecStart=/home/ntemusejoel/poly-money-maker/.venv/bin/python -m sim.shadow --config sim/strategy.sim.50.json
Restart=always
RestartSec=5
Slice=polyshadow-slice.slice
MemoryMax=200M
CPUQuota=20%

[Install]
WantedBy=multi-user.target
