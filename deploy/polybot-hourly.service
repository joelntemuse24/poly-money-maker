[Unit]
Description=Polymarket BTC hourly sell-only bot (bothourly.py, btc-up-down-hourly series)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ntemusejoel
WorkingDirectory=/home/ntemusejoel/poly-money-maker
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ntemusejoel/poly-money-maker/.venv/bin/python bothourly.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
