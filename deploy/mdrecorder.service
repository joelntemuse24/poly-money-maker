[Unit]
Description=mdrecorder standalone BTC market-data recorder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/mdrecorder
Environment=PYTHONUNBUFFERED=1
Environment=MDREC_MAX_GB=22
ExecStart=/home/ubuntu/mdrecorder/.venv/bin/python -m mdrecorder.run --out /home/ubuntu/mdrecorder/out
Restart=always
RestartSec=5
Nice=19
IOSchedulingClass=idle
CPUQuota=40%
MemoryMax=400M
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
