[Unit]
Description=Continuous armer for the hourly polybuy mint instance (writes buy_data_hourly/ARM every 30s)
After=network-online.target

[Service]
Type=simple
User=ntemusejoel
ExecStart=/bin/bash -c 'mkdir -p /home/ntemusejoel/poly-money-maker/buy_data_hourly; while :; do echo MINT_REAL_PUSD > /home/ntemusejoel/poly-money-maker/buy_data_hourly/ARM; sleep 30; done'
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
